{
  "rules": {
    "matchScores": {
      "$matchId": {
        "$playerUid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $playerUid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
        }
      }
    },
    "matchStatus": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('player1Uid').val() === auth.uid || data.child('player2Uid').val() === auth.uid || (data.child('player2Uid').val() === '' && newData.child('player2Uid').val() === auth.uid))",
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/WAITING|READY|IN_PROGRESS|COMPLETED/)"
        },
        "player1Uid": {
          ".validate": "newData.isString()"
        },
        "player2Uid": {
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
