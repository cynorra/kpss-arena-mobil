{
  "rules": {
    "matchScores": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null && 

          (data.child('player1Uid').val() === auth.uid || 
           data.child('player2Uid').val() === auth.uid)",
        "player1Score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
        },
        "player2Score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 40"
        }
      }
    },
    "matchStatus": {
      "$matchId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "status": {
          ".validate": "newData.isString() && 
            newData.val().matches(/WAITING|READY|IN_PROGRESS|COMPLETED/)"
        }
      }
    }
  }
}
