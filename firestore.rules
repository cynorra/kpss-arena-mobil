rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if isAuthenticated();
      
      // Users can only create their own profile
      allow create: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.keys().hasAll(['username', 'email', 'createdAt']) &&
        request.resource.data.username is string &&
        request.resource.data.username.size() >= 3;
      
      // Users can update their own profile
      allow update: if isAuthenticated() && isOwner(userId) &&
        !request.resource.data.keys().hasAny(['totalScore', 'weeklyScore', 'monthlyScore']);
      
      // Users can delete their own profile (account deletion)
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Daily tests collection
    match /dailyTests/{date} {
      // All authenticated users can read tests
      allow read: if isAuthenticated();
      
      // Only admin can create/update tests
      allow create, update: if isAdmin();
      
      // No deletion allowed
      allow delete: if false;
    }
    
    // Daily results (scores)
    match /dailyResults/{date}/scores/{userId} {
      // Anyone can read scores (leaderboard)
      allow read: if isAuthenticated();
      
      // Users can only submit their own scores
      allow create: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.keys().hasAll(['netScore', 'totalScore', 'completedAt', 'answers']) &&
        request.resource.data.totalScore is number;
      
      // Users can update their own scores if not locked
      allow update: if isAuthenticated() && isOwner(userId) &&
        request.time < timestamp.date(date).toMillis() + 86400000; // 24 hours window
      
      // No deletion
      allow delete: if false;
    }
    
    // Matches
    match /matches/{matchId} {
      // Match participants can read
      allow read: if isAuthenticated() && 
        (resource.data.player1Uid == request.auth.uid || 
         resource.data.player2Uid == request.auth.uid);
      

      // Authenticated users can create matches
      allow create: if isAuthenticated() && 
        request.resource.data.player1Uid == request.auth.uid;
      
      // Participants can update match
      allow update: if isAuthenticated() &&
        (resource.data.player1Uid == request.auth.uid || 
         resource.data.player2Uid == request.auth.uid) &&
        resource.data.status != 'COMPLETED';
      
      // No deletion
      allow delete: if false;
    }
    
    // Social feed - public achievement posts (auto-generated by the app, no free text)
    match /feedPosts/{postId} {
      // Public feed - any authenticated user can read
      allow read: if isAuthenticated();

      // Only the post's own owner can create it
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasAll(['uid', 'username', 'type', 'score', 'createdAt']);

      // Anyone can toggle likes, but ONLY the likedBy field may change -
      // post content (score, username, type, etc.) is immutable after creation
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']);

      // No deletion
      allow delete: if false;
    }

    // Mock exam (Deneme Sinavi) results - personal history, not ranked/shared
    match /mockExamResults/{userId}/attempts/{attemptId} {
      // Only the owner can read their own attempt history
      allow read: if isAuthenticated() && isOwner(userId);

      // Only the owner can record their own attempts
      allow create: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.keys().hasAll(['netScore', 'totalScore', 'completedAt']) &&
        request.resource.data.totalScore is number;

      // Attempts are immutable once recorded
      allow update, delete: if false;
    }

    // Question pool (feeds Arena matches and auto-generated daily tests)
    match /QuestionPool/{questionId} {
      // All authenticated users can read (client pulls random questions for matches)
      allow read: if isAuthenticated();

      // Only admin can add/edit/remove questions
      allow create, update, delete: if isAdmin();
    }

    // Admin users
    match /adminUsers/{userId} {
      // Only admin can read admin list
      allow read: if isAdmin();
      
      // Only existing admins can add new admins
      allow create: if isAdmin();
      
      // Only admin can modify
      allow update, delete: if isAdmin();
    }
    
  }
}
