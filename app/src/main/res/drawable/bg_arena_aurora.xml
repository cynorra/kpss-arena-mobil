                android:startColor="#2E3B82F6"
                android:centerColor="#123B82F6"
                android:endColor="#003B82F6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="65%p"
                android:centerX="0.92"
