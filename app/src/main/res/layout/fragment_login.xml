<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center">

        <!-- Logo / Title -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_sym_account_balance"
            app:tint="@color/primary"
            android:importantForAccessibility="no"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="32sp"
            android:fontFamily="@font/playfair_display_bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:textColor="@color/on_surface_variant"
            android:textSize="15sp"
            android:fontFamily="@font/inter_regular"
            android:layout_marginBottom="40dp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp"
            android:indeterminateTint="@color/primary" />

        <!-- Google Sign-In -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_google_sign_in"
            style="@style/Widget.KPSSArena.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/action_google_sign_in"
            android:fontFamily="@font/inter_semibold"
            android:textSize="15sp"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:layout_marginBottom="16dp" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginVertical="12dp">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/outline_variant" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_or_divider"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                android:fontFamily="@font/inter_regular"
                android:paddingHorizontal="16dp" />
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/outline_variant" />
        </LinearLayout>

        <!-- Guest Sign-In -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_guest_sign_in"
            style="@style/Widget.KPSSArena.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/action_guest_sign_in"
            android:textColor="@color/on_primary"
            android:fontFamily="@font/inter_semibold"
            android:textSize="15sp"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_sym_person"
            app:iconTint="@color/on_primary"
            app:iconGravity="textStart"
            app:cornerRadius="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tv_guest_notice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guest_info_notice"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:fontFamily="@font/inter_regular" />

    </LinearLayout>
</ScrollView>
