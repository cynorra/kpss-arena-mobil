<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.test.TestResultFragment">
    <FrameLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content">
        <!-- Confetti Lottie -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_confetti"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <!-- Result Header -->
            <TextView
                android:id="@+id/tv_result_emoji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🏆"
                android:textSize="48sp"
                android:gravity="center"
                android:layout_marginBottom="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Tamamlandı!"
                android:textColor="@color/on_surface"
                android:textSize="24sp"
                android:fontFamily="@font/playfair_display_bold"
                android:gravity="center"
                android:layout_marginBottom="4dp" />
            <!-- Rank Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_rank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:padding="20dp">
                    <TextView
                        android:id="@+id/tv_rank_medal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="36sp"
                        android:layout_marginEnd="12dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sıralaman"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp" />
                        <TextView
                            android:id="@+id/tv_rank"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="#1"
                            android:textColor="@color/primary"
                            android:textSize="36sp"
                            android:fontFamily="@font/inter_bold" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Total Score -->
            <TextView
                android:id="@+id/tv_total_score"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/primary"
                android:textSize="72sp"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toplam Puan"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="24dp" />
            <!-- Score Breakdown -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detaylar"
                        android:textColor="@color/on_surface"
                        android:textSize="16sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginBottom="16dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_correct_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/success"
                                android:textSize="28sp"
                                android:fontFamily="@font/inter_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Doğru"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_wrong_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/error"
                                android:textSize="28sp"
                                android:fontFamily="@font/inter_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Yanlış"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">
                            <TextView
                                android:id="@+id/tv_empty_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"

                                android:textColor="@color/on_surface_variant"
                                android:textSize="28sp"
                                android:fontFamily="@font/inter_bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Boş"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginVertical="12dp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Net Skor"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp" />
                            <TextView

                                android:id="@+id/tv_net_score"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/on_surface"
                                android:textSize="20sp"
                                android:fontFamily="@font/inter_bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hız Bonusu"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tv_speed_bonus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+0"
                                android:textColor="@color/primary"
                                android:textSize="20sp"
                                android:fontFamily="@font/inter_bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Başarı"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/tv_accuracy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="%0"
                                android:textColor="@color/info"
                                android:textSize="20sp"
                                android:fontFamily="@font/inter_bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Action Buttons -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_to_home"
                style="@style/Widget.KPSSArena.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Ana Sayfaya Dön"
                android:textColor="@color/on_primary"
                app:backgroundTint="@color/primary"
                android:layout_marginBottom="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_leaderboard"
                style="@style/Widget.KPSSArena.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="56dp"

                android:text="Liderlik Tablosunu Gör"
                android:layout_marginBottom="12dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                style="@style/Widget.KPSSArena.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📤 Sonucu Paylaş"
                app:icon="@drawable/ic_share" />
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
