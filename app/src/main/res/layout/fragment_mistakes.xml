<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_surface"
            android:contentDescription="@string/action_cancel" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mistakes_title"
            android:textColor="@color/on_surface"
            android:textSize="22sp"
            android:fontFamily="@font/inter_bold"
            app:fontFamily="@font/inter_bold"
            android:textStyle="normal"
            android:letterSpacing="0.01"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/tv_mistake_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="@string/placeholder_zero"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            app:fontFamily="@font/inter_bold"
            android:textStyle="normal"
            android:letterSpacing="0.01" />
    </LinearLayout>

    <!-- Modern Horizontal Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- Retry All Action Banner -->
    <LinearLayout
        android:id="@+id/container_retry_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_all"
            style="@style/Widget.KPSSArena.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/action_retry_all_mistakes"
            android:textSize="14sp"
            app:cornerRadius="24dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1.2dp"
            android:textColor="@color/primary" />
    </LinearLayout>

    <!-- Mistakes List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mistakes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp"
        android:scrollbars="none" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/tv_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="160dp"
            android:layout_height="160dp"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/empty_state" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mistakes_empty_title"
            android:textColor="@color/on_surface"
            android:textSize="18sp"
            android:fontFamily="@font/inter_bold"
            app:fontFamily="@font/inter_bold"
            android:textStyle="normal"
            android:letterSpacing="0.01"
            android:layout_marginTop="16dp"
            android:textAlignment="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mistakes_empty_subtext"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:fontFamily="@font/inter_regular"
            app:fontFamily="@font/inter_regular"
            android:textStyle="normal"
            android:lineSpacingMultiplier="1.25"
            android:textAlignment="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>
