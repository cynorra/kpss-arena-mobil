<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ Admin Panel"
        android:textColor="@color/on_surface"
        android:textSize="24sp"
        android:fontFamily="@font/playfair_display_bold"
        android:layout_marginBottom="24dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_question"
        style="@style/Widget.KPSSArena.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="➕ Soru Ekle"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scheduled_tests"
        style="@style/Widget.KPSSArena.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📅 Planlanan Testler"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_user_management"
        style="@style/Widget.KPSSArena.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="👥 Kullanıcı Yönetimi"
        android:layout_marginBottom="12dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_scheduled_tests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false" />
</LinearLayout>
