<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".presentation.home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- Centered responsive container (caps width at 640dp on wide/landscape screens) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="640dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="28dp">

                <!-- Header: Avatar, Greeting, Streak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="22dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:src="@drawable/ic_default_avatar"
                        app:civ_border_color="@color/primary"
                        app:civ_border_width="2.5dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="14dp">

                        <TextView
                            android:id="@+id/tv_greeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_greeting"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_regular" />

                        <TextView
                            android:id="@+id/tv_username"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/default_username"
                            android:textColor="@color/on_surface"
                            android:textSize="22sp"
                            android:fontFamily="@font/inter_bold" />
                    </LinearLayout>

                    <!-- Streak Badge Pill (Pure White + Crisp Hairline) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:paddingHorizontal="14dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_sym_local_fire_department"
                                app:tint="@color/warning"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tv_streak_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/placeholder_zero"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp"
                                android:fontFamily="@font/inter_bold"
                                android:layout_marginStart="5dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- KPSS Exam Countdown & Score Calculator Strip (Editorial White) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_kpss_cockpit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="13dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="10dp">

                            <TextView
                                android:id="@+id/tv_kpss_countdown_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp"
                                tools:text="KPSS Lisans'a 230 Gün" />

                            <TextView
                                android:id="@+id/tv_kpss_countdown_sub"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"
                                android:text="@string/kpss_countdown_tap_hint"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_kpss_calculator"
                            style="@style/Widget.KPSSArena.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/kpss_calc_open_btn"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            app:backgroundTint="@color/primary_container"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Daily Test Hero Card (High-Contrast Editorial Obsidian Ink on Porcelain) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_daily_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <!-- Shimmer placeholder -->
                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_test_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:orientation="vertical"
                            android:padding="20dp" />
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hero_daily_arena"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="14dp">

                            <!-- Crisp Dark-Ink Eyebrow Pill -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#263B82F6"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="@string/home_daily_test_label"
                                android:textColor="#93C5FD"
                                android:textSize="10.5sp"
                                android:fontFamily="@font/inter_bold"
                                android:letterSpacing="0.08" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_sym_assignment"
                                app:tint="#93C5FD"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_today_test_title"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:fontFamily="@font/inter_bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tv_test_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_test_status_default"
                            android:textColor="#94A3B8"
                            android:textSize="13.5sp"
                            android:fontFamily="@font/inter_regular"
                            android:layout_marginBottom="18dp" />

                        <!-- Crisp Pure-White High-Contrast CTA -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_start_test"
                            style="@style/Widget.KPSSArena.Button"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:text="@string/action_start_test"
                            android:textColor="#0F172A"
                            app:backgroundTint="#FFFFFF"
                            app:icon="@drawable/ic_play"
                            app:iconTint="#0F172A"
                            app:iconGravity="textStart"
                            app:cornerRadius="16dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2-Column Editorial Bento Grid: Deneme Sınavı & Konu Pratiği -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <!-- Left Bento: KPSS Deneme Sınavı -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_mock_exam"
                        android:layout_width="0dp"
                        android:layout_height="152dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="7dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_badge_blue">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sym_school"
                                    app:tint="@color/primary"
                                    android:importantForAccessibility="no" />
                            </FrameLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/home_mock_exam_title"
                                android:textColor="@color/on_surface"
                                android:textSize="15.5sp"
                                android:fontFamily="@font/inter_bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="GY-GK • Eğitim • Branş"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11.5sp"
                                android:fontFamily="@font/inter_regular"
                                android:layout_marginTop="3dp"
                                android:maxLines="2" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Right Bento: Konu Pratiği -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_practice"
                        android:layout_width="0dp"
                        android:layout_height="152dp"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_icon_badge_gold">
                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sym_target"
                                    app:tint="@color/warning"
                                    android:importantForAccessibility="no" />
                            </FrameLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/home_practice_title"
                                android:textColor="@color/on_surface"
                                android:textSize="15.5sp"
                                android:fontFamily="@font/inter_bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/home_practice_subtitle"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11.5sp"
                                android:fontFamily="@font/inter_regular"
                                android:layout_marginTop="3dp"
                                android:maxLines="2"
                                android:ellipsize="end" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Quick Action Cards Row (Stats, Mistakes, Flashcards) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- Progress / Stats -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_view_stats"
                        android:layout_width="0dp"
                        android:layout_height="104dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="10dp">

                            <FrameLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_icon_badge_blue"
                                android:layout_marginBottom="6dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sym_trending_up"
                                    app:tint="@color/info"
                                    android:importantForAccessibility="no" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_progress_title"
                                android:textColor="@color/on_surface"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter_semibold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Mistake Archive -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_view_mistakes"
                        android:layout_width="0dp"
                        android:layout_height="104dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="10dp">

                            <FrameLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_icon_badge_coral"
                                android:layout_marginBottom="6dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sym_edit_note"
                                    app:tint="@color/error"
                                    android:importantForAccessibility="no" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_mistakes_archive_title"
                                android:textColor="@color/on_surface"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter_semibold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Flashcards -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_view_flashcards"
                        android:layout_width="0dp"
                        android:layout_height="104dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="@color/surface"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="10dp">

                            <FrameLayout
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_icon_badge_purple"
                                android:layout_marginBottom="6dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_sym_style"
                                    app:tint="#A855F7"
                                    android:importantForAccessibility="no" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_flashcard_title"
                                android:textColor="@color/on_surface"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter_semibold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Level / XP / Daily Goal Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_level"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/primary"
                                android:textSize="16sp"
                                android:fontFamily="@font/inter_bold" />

                            <TextView
                                android:id="@+id/tv_xp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                android:fontFamily="@font/inter_semibold" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_xp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:progressTint="@color/primary"
                            android:progressBackgroundTint="@color/outline_variant" />

                        <TextView
                            android:id="@+id/tv_goal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_semibold"
                            android:layout_marginTop="16dp" />

                        <ProgressBar
                            android:id="@+id/progress_goal"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="8dp"
                            android:progressTint="@color/success"
                            android:progressBackgroundTint="@color/outline_variant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mini Leaderboard Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="20dp">

                    <!-- Shimmer placeholder -->
                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_leaderboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:orientation="vertical" />
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_leaderboard_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_leaderboard_title"
                            android:textColor="@color/on_surface"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter_bold"
                            android:layout_marginBottom="12dp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_mini_leaderboard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_leaderboard_mini" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Invite Friends Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_invite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="18dp">

                        <FrameLayout
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_icon_badge_gold"
                            android:layout_marginEnd="16dp">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_sym_ios_share"
                                app:tint="@color/primary"
                                android:importantForAccessibility="no" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/invite_title"
                                android:textColor="@color/on_surface"
                                android:textSize="16sp"
                                android:fontFamily="@font/inter_bold" />

                            <TextView
                                android:id="@+id/tv_invite_code"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="13sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/primary"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AdMob Adaptive Banner Container -->
                <FrameLayout
                    android:id="@+id/ad_banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
