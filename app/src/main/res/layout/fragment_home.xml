<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxWidth="640dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp">

                <!-- 1. Unified Top Profile, Streak & Exam Countdown Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_kpss_cockpit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/iv_avatar"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:src="@drawable/ic_default_avatar"
                            app:civ_border_color="@color/primary_border"
                            app:civ_border_width="2dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="11dp"
                            android:layout_marginEnd="8dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_username"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/inter_bold"
                                    android:maxLines="1"
                                    android:text="@string/default_username"
                                    android:textColor="@color/on_surface"
                                    android:textSize="14sp" />

                                <LinearLayout
                                    android:id="@+id/card_streak"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_pill_amber"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp">

                                    <TextView
                                        android:id="@+id/tv_streak_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_bold"
                                        android:text="🔥 0 Gün"
                                        android:textColor="@color/warning"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_kpss_exam_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_bold"
                                    android:letterSpacing="0.04"
                                    android:text="KPSS 2027 · LİSANS"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_pill_blue"
                                    android:fontFamily="@font/inter_bold"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="1.5dp"
                                    android:text="@string/home_target_p3"
                                    android:textColor="@color/primary"
                                    android:textSize="9.5sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_kpss_countdown_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum, lnum"
                                android:fontFamily="@font/inter_bold"
                                android:textColor="@color/on_surface"
                                android:textSize="12sp"
                                tools:text="232 Gün Kaldı" />

                            <TextView
                                android:id="@+id/tv_kpss_countdown_sub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"
                                android:text="18 Temmuz 2027 ›"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. HERO BOOKLET: GÜNLÜK ÖSYM KİTAPÇIĞI (Obsidian #0F172A) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_daily_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_test_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:orientation="vertical" />
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hero_daily_arena"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Top Header Strip -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="10dp">

                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_circle_cobalt" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_bold"
                                android:letterSpacing="0.06"
                                android:text="@string/home_sync_discipline"
                                android:textColor="#CBD5E1"
                                android:textSize="10sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_obsidian_blue"
                                android:fontFeatureSettings="tnum, lnum"
                                android:fontFamily="@font/inter_bold"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="@string/home_daily_badge_meta"
                                android:textColor="#DBEAFE"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="12dp"
                            android:background="#1AFFFFFF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:letterSpacing="-0.02"
                            android:text="@string/home_daily_hero_title"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/tv_test_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="14dp"
                            android:fontFamily="@font/inter_regular"
                            android:lineSpacingMultiplier="1.35"
                            android:text="@string/home_daily_hero_desc"
                            android:textColor="#CBD5E1"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_start_test"
                            style="@style/Widget.KPSSArena.Button"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="46dp"
                            android:text="@string/home_daily_hero_cta"
                            android:textColor="@color/obsidian"
                            android:textSize="13sp"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_arrow_forward"
                            app:iconGravity="textEnd"
                            app:iconSize="16dp"
                            app:iconTint="@color/obsidian" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. 2-COLUMN STRATEGIC BENTO GRID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <!-- Left Bento: ÖSYM Soru Havuzu -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_mock_exam"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/bg_pill_blue"
                                android:fontFamily="@font/inter_bold"
                                android:gravity="center"
                                android:text="TG"
                                android:textColor="@color/primary"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/home_bento_pool_title"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter_regular"
                                android:lineSpacingMultiplier="1.25"
                                android:text="@string/home_bento_pool_desc"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="8dp"
                                android:background="@color/outline_variant" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/inter_bold"
                                    android:text="@string/home_bento_pool_cta"
                                    android:textColor="@color/primary"
                                    android:textSize="11.5sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_bold"
                                    android:text="›"
                                    android:textColor="@color/primary"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Right Bento: Zayıf Halka & Hatalar -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_view_mistakes"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginBottom="10dp"
                                android:background="@drawable/bg_pill_rose"
                                android:fontFamily="@font/inter_bold"
                                android:gravity="center"
                                android:text="!"
                                android:textColor="@color/error"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/home_bento_mistakes_title"
                                android:textColor="@color/on_surface"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/inter_regular"
                                android:lineSpacingMultiplier="1.25"
                                android:text="@string/home_bento_mistakes_desc"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="8dp"
                                android:background="@color/outline_variant" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/inter_bold"
                                    android:text="@string/home_bento_mistakes_cta"
                                    android:textColor="@color/error"
                                    android:textSize="11.5sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter_bold"
                                    android:text="›"
                                    android:textColor="@color/error"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 4. STATS, LEVEL & SCORE CALCULATOR STRIP -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_pill_emerald" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_level"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_bold"
                                        android:textColor="@color/on_surface"
                                        android:textSize="13sp"
                                        tools:text="Seviye 4" />

                                    <TextView
                                        android:id="@+id/tv_xp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:fontFeatureSettings="tnum, lnum"
                                        android:fontFamily="@font/inter_semibold"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="11sp"
                                        tools:text="120 / 200 XP" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_goal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/inter_regular"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="11sp"
                                    tools:text="Günlük hedef: 8/20 soru" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_kpss_calculator"
                                style="@style/Widget.KPSSArena.Button"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="34dp"
                                android:paddingHorizontal="12dp"
                                android:text="@string/kpss_calc_open_btn"
                                android:textColor="@color/primary"
                                android:textSize="11sp"
                                app:backgroundTint="@color/primary_container"
                                app:cornerRadius="10dp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/progress_xp"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="10dp"
                            android:progressBackgroundTint="@color/outline_variant"
                            android:progressTint="@color/primary" />

                        <ProgressBar
                            android:id="@+id/progress_goal"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:layout_marginTop="6dp"
                            android:progressBackgroundTint="@color/outline_variant"
                            android:progressTint="@color/success" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. QUICK TOOLS ROW (Konu Pratiği, Flash Kartlar, Gelişim) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_practice"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginBottom="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sym_target"
                                app:tint="@color/warning" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/home_practice_title"
                                android:textColor="@color/on_surface"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_view_flashcards"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginBottom="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sym_style"
                                app:tint="@color/subject_vatandaslik" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/home_flashcard_title"
                                android:textColor="@color/on_surface"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_view_stats"
                        android:layout_width="0dp"
                        android:layout_height="84dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginBottom="6dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sym_trending_up"
                                app:tint="@color/primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/home_progress_title"
                                android:textColor="@color/on_surface"
                                android:textSize="11.5sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- 6. MINI LEADERBOARD CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_mini_leaderboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_leaderboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:orientation="vertical" />
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_leaderboard_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/home_leaderboard_title"
                                android:textColor="@color/on_surface"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_leaderboard_see_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/inter_bold"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:text="@string/home_see_all"
                                android:textColor="@color/primary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_mini_leaderboard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/item_leaderboard_mini" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 7. INVITE FRIENDS CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_invite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_pill_blue">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_sym_ios_share"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="@string/invite_title"
                                android:textColor="@color/on_surface"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tv_invite_code"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_regular"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="›"
                            android:textColor="@color/primary"
                            android:textSize="18sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- AdMob Adaptive Banner Container -->
                <FrameLayout
                    android:id="@+id/ad_banner_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
