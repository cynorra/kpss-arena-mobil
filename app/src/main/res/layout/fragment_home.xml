<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.home.HomeFragment">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_default_avatar"
                    app:civ_border_color="@color/primary"
                    app:civ_border_width="2dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:id="@+id/tv_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_greeting"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular" />
                    <TextView
                        android:id="@+id/tv_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/default_username"
                        android:textColor="@color/on_surface"
                        android:textSize="20sp"
                        android:fontFamily="@font/inter_bold" />
                </LinearLayout>
                <!-- Premium Badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_streak"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardBackgroundColor="@color/primary_container"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingHorizontal="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_streak_emoji"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/tv_streak_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/placeholder_zero"
                            android:textColor="@color/on_primary_container"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_bold"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <!-- Daily Test Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_daily_test"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="0.5dp"
                android:layout_marginBottom="20dp"

                android:clickable="true"
                android:focusable="true">
                <!-- Shimmer placeholder -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_test_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:orientation="vertical"
                        android:padding="20dp" />
                </com.facebook.shimmer.ShimmerFrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_daily_test_label"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_semibold"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="8dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_today_test_title"
                        android:textColor="@color/on_surface"
                        android:textSize="22sp"
                        android:fontFamily="@font/playfair_display_bold"

                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/tv_test_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_test_status_default"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginBottom="16dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_start_test"
                        style="@style/Widget.KPSSArena.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/action_start_test"
                        android:textColor="@color/on_primary"
                        app:backgroundTint="@color/primary"
                        app:icon="@drawable/ic_play"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Mock Exam (Deneme Sınavı) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_mock_exam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="0.5dp"
                android:layout_marginBottom="20dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_mock_exam_emoji"
                        android:textSize="28sp"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_mock_exam_title"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_arrow"
                        android:textColor="@color/primary"
                        android:textSize="20sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- Quick Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_view_stats"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="0.5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_progress_emoji"
                            android:textSize="28sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_progress_title"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_view_mistakes"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="6dp"

                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="0.5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_mistakes_emoji"
                            android:textSize="28sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_mistakes_archive_title"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_view_flashcards"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="0.5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_flashcard_emoji"
                            android:textSize="28sp"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_flashcard_title"
                            android:textColor="@color/on_surface"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <!-- Mini Leaderboard -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="0.5dp"
                android:layout_marginBottom="20dp">
                <!-- Shimmer placeholder -->
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_leaderboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:orientation="vertical" />
                </com.facebook.shimmer.ShimmerFrameLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <TextView
                        android:id="@+id/tv_leaderboard_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_leaderboard_title"
                        android:textColor="@color/on_surface"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginBottom="12dp" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_mini_leaderboard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_leaderboard_mini" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <!-- AdMob Banner -->
            <com.google.android.gms.ads.AdView
                android:id="@+id/ad_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:adSize="BANNER"
                app:adUnitId="ca-app-pub-4674211063760769/2688135839" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>