<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.mockexam.MockExamFragment">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="@color/surface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Header: Back, Exam Title & Section, Counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_exit_exam"
                style="@style/Widget.KPSSArena.Button.Outlined"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconTint="@color/on_surface"
                app:strokeColor="@color/outline"
                android:contentDescription="@string/action_finish_mock_exam" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="8dp">

                <TextView
                    android:id="@+id/tv_exam_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_mock_exam_title"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_section_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_semibold"
                    tools:text="GENEL YETENEK • TÜRKÇE" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_question_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/mock_exam_question_counter_default"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:fontFamily="@font/inter_bold" />
        </LinearLayout>

        <!-- Timer & Progress Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tv_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mock_exam_timer_default"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:fontFamily="@font/inter_bold"
                android:layout_marginEnd="12dp" />

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:progressTint="@color/primary"
                android:progressBackgroundTint="@color/outline_variant" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Category Pill & 50/50 Joker Button Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_category_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="@string/test_category_default"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_semibold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- 50/50 Joker Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_joker_fifty"
                    style="@style/Widget.KPSSArena.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="@string/action_joker_fifty"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_semibold"
                    app:icon="@drawable/ic_sym_lightbulb"
                    app:iconSize="16dp"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- Question Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_question_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/placeholder_question_text"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_semibold"
                    android:lineSpacingMultiplier="1.35"
                    android:padding="22dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Option A -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="1.2dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/badge_option_a"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:background="@drawable/bg_option_badge"
                        android:text="@string/option_label_a"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:id="@+id/tv_option_a"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.25"
                        tools:text="A şıkkı cevabı buraya gelecek" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option B -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="1.2dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/badge_option_b"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:background="@drawable/bg_option_badge"
                        android:text="@string/option_label_b"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:id="@+id/tv_option_b"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.25"
                        tools:text="B şıkkı cevabı buraya gelecek" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option C -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="1.2dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/badge_option_c"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:background="@drawable/bg_option_badge"
                        android:text="@string/option_label_c"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:id="@+id/tv_option_c"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.25"
                        tools:text="C şıkkı cevabı buraya gelecek" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option D -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="1.2dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/badge_option_d"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:background="@drawable/bg_option_badge"
                        android:text="@string/option_label_d"
                        android:textColor="@color/primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginEnd="14dp" />

                    <TextView
                        android:id="@+id/tv_option_d"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.25"
                        tools:text="D şıkkı cevabı buraya gelecek" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_previous"
            style="@style/Widget.KPSSArena.Button.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconTint="@color/on_surface"
            app:strokeColor="@color/outline"
            app:strokeWidth="1.5dp"
            app:cornerRadius="24dp"
            android:layout_marginEnd="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_exam"
            style="@style/Widget.KPSSArena.Button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/action_finish_mock_exam"
            android:textColor="@color/on_primary"
            android:fontFamily="@font/inter_bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_next"
            style="@style/Widget.KPSSArena.Button.Outlined"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textStart"
            app:iconTint="@color/on_surface"
            app:strokeColor="@color/outline"
            app:strokeWidth="1.5dp"
            app:cornerRadius="24dp"
            android:layout_marginStart="10dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
