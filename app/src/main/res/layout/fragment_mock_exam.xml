<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.mockexam.MockExamFragment">

    <!-- ÖSYM Minimal Crisp Top Bar Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/outline"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_exit_exam"
                    style="@style/Widget.KPSSArena.Button.Outlined"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/surface_variant"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_arrow_back"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/on_surface"
                    app:strokeWidth="0dp"
                    android:contentDescription="@string/action_finish_mock_exam" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_exam_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_bold"
                        android:maxLines="1"
                        android:text="@string/home_mock_exam_title"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_section_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_semibold"
                        android:maxLines="1"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="10sp"
                        tools:text="GENEL KÜLTÜR • TARİH" />
                </LinearLayout>

                <!-- Calm Tabular Digital Timer Pill -->
                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_blue"
                    android:fontFeatureSettings="tnum, lnum"
                    android:fontFamily="@font/inter_bold"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="@string/mock_exam_timer_default"
                    android:textColor="@color/primary"
                    android:textSize="12sp" />

                <!-- Counter -->
                <TextView
                    android:id="@+id/tv_question_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFeatureSettings="tnum, lnum"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/mock_exam_question_counter_default"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="11.5sp" />

                <!-- Obsidian Palet Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_palette"
                    style="@style/Widget.KPSSArena.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/exam_palette_btn"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    app:backgroundTint="@color/obsidian"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:progressBackgroundTint="@color/outline_variant"
                android:progressTint="@color/primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable ÖSYM Question Booklet Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <!-- Category Chip & 50/50 Joker Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_category_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_blue"
                    android:fontFamily="@font/inter_bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/test_category_default"
                    android:textColor="@color/primary"
                    android:textSize="11sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_joker_fifty"
                    style="@style/Widget.KPSSArena.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="@string/action_joker_fifty"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_sym_lightbulb"
                    app:iconSize="14dp"
                    app:iconTint="@color/primary"
                    app:strokeColor="@color/primary_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Official Booklet Question Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tv_question_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingMultiplier="1.45"
                    android:padding="18dp"
                    android:text="@string/placeholder_question_text"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Option A -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/badge_option_a"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="@string/option_label_a"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_option_a"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp"
                        tools:text="A şıkkı" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option B -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/badge_option_b"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="@string/option_label_b"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_option_b"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp"
                        tools:text="B şıkkı" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option C -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/badge_option_c"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="@string/option_label_c"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_option_c"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp"
                        tools:text="C şıkkı" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option D -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/badge_option_d"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="@string/option_label_d"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_option_d"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp"
                        tools:text="D şıkkı" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option E -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_option_e"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/badge_option_e"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_option_badge"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="@string/option_label_e"
                        android:textColor="@color/on_surface"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_option_e"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/on_surface"
                        android:textSize="13.5sp"
                        tools:text="E şıkkı" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Clean 2-Row ÖSYM Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Row 1: Önceki Soru | Sonraki Soru -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_previous"
                style="@style/Widget.KPSSArena.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="44dp"
                android:text="@string/action_prev_question"
                android:textColor="@color/on_surface"
                android:textSize="12.5sp"
                app:backgroundTint="@color/surface"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/on_surface"
                app:strokeColor="@color/outline"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_next"
                style="@style/Widget.KPSSArena.Button"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="44dp"
                android:text="@string/action_next_question"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconSize="16dp"
                app:iconTint="#FFFFFF" />
        </LinearLayout>

        <!-- Row 2: ⚑ Boş Bırak / Bayrakla | Testi Bitir -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_flag_question"
                style="@style/Widget.KPSSArena.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="38dp"
                android:text="@string/exam_flag_blank_btn"
                android:textColor="@color/on_surface_variant"
                android:textSize="11.5sp"
                app:backgroundTint="@color/surface_variant"
                app:cornerRadius="10dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_exam"
                style="@style/Widget.KPSSArena.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="38dp"
                android:paddingHorizontal="16dp"
                android:text="@string/action_finish_test"
                android:textColor="@color/error"
                android:textSize="11.5sp"
                app:backgroundTint="@color/error_bg"
                app:cornerRadius="10dp"
                app:strokeWidth="0dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
