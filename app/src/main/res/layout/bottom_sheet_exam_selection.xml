<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Title and Subtitle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="16dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_sym_school"
            app:tint="@color/primary"
            android:importantForAccessibility="no"
            android:layout_marginEnd="12dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exam_hub_title"
                android:textColor="@color/on_surface"
                android:textSize="18sp"
                android:fontFamily="@font/inter_bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exam_hub_subtitle"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp"
                android:fontFamily="@font/inter_regular" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Full KPSS Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_exam_full"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/exam_title_full_kpss"
                            android:textColor="@color/primary"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exam_badge_official"
                            android:background="@drawable/bg_badge_gold"
                            android:textColor="@color/on_primary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter_semibold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exam_desc_full_kpss"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exam_meta_full_kpss"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_semibold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- GY & GK Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <!-- GY Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_exam_gy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="0.5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exam_title_gy"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exam_desc_gy"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exam_meta_gy"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- GK Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_exam_gk"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface"
                    app:strokeColor="@color/outline"
                    app:strokeWidth="0.5dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exam_title_gk"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:fontFamily="@font/inter_bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exam_desc_gk"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/exam_meta_gk"
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/inter_semibold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Branch Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exam_section_branch"
                android:textColor="@color/on_surface"
                android:textSize="14sp"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- Branch Items -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_branch_turkce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0.5dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="0.5dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/exam_branch_turkce"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exam_branch_turkce_meta"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_branch_matematik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0.5dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="0.5dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/exam_branch_matematik"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exam_branch_matematik_meta"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_branch_tarih"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0.5dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="0.5dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/exam_branch_tarih"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exam_branch_tarih_meta"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_branch_cografya"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0.5dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="0.5dp"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/exam_branch_cografya"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exam_branch_cografya_meta"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_branch_vatandaslik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0.5dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="0.5dp"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="12dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/exam_branch_vatandaslik"
                        android:textColor="@color/on_surface"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter_semibold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/exam_branch_vatandaslik_meta"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter_regular" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
