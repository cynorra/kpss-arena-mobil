<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="20dp">
    <!-- Arena Header -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚔️ ARENA"
        android:textColor="@color/primary"
        android:textSize="32sp"
        android:fontFamily="@font/playfair_display_bold"
        android:layout_marginBottom="8dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rakibine meydan oku, zirveye çık!"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:layout_marginBottom="24dp" />
    <!-- Challenge Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_challenge"
        style="@style/Widget.KPSSArena.Button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🎯 Kullanıcı Adıyla Meydan Oku"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_swords"
        app:iconGravity="textStart"
        android:layout_marginBottom="12dp" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_random_match"
        style="@style/Widget.KPSSArena.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🎲 Rastgele Rakip Bul"
        app:icon="@drawable/ic_random"
        app:iconGravity="textStart"
        android:layout_marginBottom="24dp" />

    <!-- Active Matches -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aktif Maçlar"
        android:textColor="@color/on_surface"
        android:textSize="18sp"
        android:fontFamily="@font/inter_bold"
        android:layout_marginBottom="12dp" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_active_matches"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <!-- Match History -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Maç Geçmişi"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_semibold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kazandığın ve kaybettiğin maçlar"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textColor="@color/primary"
                android:textSize="24sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
