<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Arena Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arena_title"
            android:textColor="@color/primary"
            android:textSize="30sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arena_subtitle"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- HERO CARD: Deneme & Branş Düellosu -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_exam_duel_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/outline"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_daily_gradient"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_badge_gold">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_swords"
                            app:tint="@color/primary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_create_exam_duel"
                            android:textColor="@color/on_surface"
                            android:textSize="16sp"
                            android:fontFamily="@font/inter_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/action_create_exam_duel_desc"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_create_exam_duel"
                    style="@style/Widget.KPSSArena.Button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/action_create_exam_duel"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter_bold"
                    app:cornerRadius="24dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Canlı Kapışma Bölümü -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Canlı Kapışma (Hızlı 10 Soru)"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_random_match"
                style="@style/Widget.KPSSArena.Button"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/action_find_random_match"
                android:textSize="13sp"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_random"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_challenge"
                style="@style/Widget.KPSSArena.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/action_challenge_by_username"
                android:textSize="13sp"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_swords"
                app:iconGravity="textStart" />
        </LinearLayout>

        <!-- Açık Meydan Okumalar (Katılabileceğin Düellolar) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arena_open_challenges_title"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arena_open_challenges_desc"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_open_challenges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_open_challenges_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center"
            android:text="@string/arena_open_challenges_empty"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Aktif & Bekleyen Maçlarım -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/arena_active_matches_title"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:fontFamily="@font/inter_bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_active_matches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tv_active_matches_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center"
            android:text="@string/active_matches_empty_title"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Match History -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_match_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arena_match_history_title"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter_semibold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/arena_match_history_desc"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_arrow"
                    android:textColor="@color/primary"
                    android:textSize="22sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
