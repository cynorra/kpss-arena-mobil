<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (Dark) -->
    <style name="Theme.KPSSArena" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">#C9A84C</item>
        <item name="colorOnPrimary">#1A1000</item>
        <item name="colorPrimaryContainer">#3D2C00</item>
        <item name="colorOnPrimaryContainer">#FFE08C</item>
        
        <!-- Secondary colors -->
        <item name="colorSecondary">#0D1B3E</item>
        <item name="colorOnSecondary">#E8EDF7</item>
        <item name="colorSecondaryContainer">#1E2A45</item>
        <item name="colorOnSecondaryContainer">#D4E3FF</item>
        
        <!-- Tertiary -->
        <item name="colorTertiary">#A5C4FF</item>
        <item name="colorOnTertiary">#002D6B</item>
        
        <!-- Background & Surface -->
        <item name="android:colorBackground">#0A0F1E</item>
        <item name="colorSurface">#111827</item>
        <item name="colorSurfaceVariant">#1E2A45</item>
        <item name="colorOnSurface">#E2E8F0</item>
        <item name="colorOnSurfaceVariant">#C1C9D9</item>
        
        <!-- Outline -->
        <item name="colorOutline">#3A4A6B</item>
        <item name="colorOutlineVariant">#1A2A4B</item>
        
        <!-- Error -->
        <item name="colorError">#CF6679</item>
        <item name="colorOnError">#370B1E</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Font family -->
        <item name="fontFamily">@font/inter_regular</item>

        
        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.KPSSArena.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.KPSSArena.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.KPSSArena.Large</item>
    </style>
    <!-- Splash theme -->
    <style name="Theme.KPSSArena.Splash" parent="Theme.KPSSArena">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
    <!-- Shape Appearances -->
    <style name="ShapeAppearance.KPSSArena.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.KPSSArena.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.KPSSArena.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <!-- Material Button Style -->
    <style name="Widget.KPSSArena.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">56dp</item>
    </style>
    <style name="Widget.KPSSArena.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>

        <item name="strokeColor">@color/primary</item>
    </style>
    <!-- Card View Style -->
    <style name="Widget.KPSSArena.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">0.5dp</item>
    </style>
    <!-- Bottom Navigation -->
    <style name="Widget.KPSSArena.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
    </style>
    <style name="BottomNavActiveText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">@font/inter_semibold</item>
    </style>
    <style name="BottomNavInactiveText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>
</resources>
