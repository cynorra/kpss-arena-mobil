<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 2027+ Editorial Porcelain Light Theme (Kunduz / Notion / Apple Books Clarity) -->
    <style name="Theme.KPSSArena" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>

        <!-- Tertiary -->
        <item name="colorTertiary">#059669</item>
        <item name="colorOnTertiary">#FFFFFF</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Crisp Light Status & Navigation Bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Universal Inter Font Family -->
        <item name="android:fontFamily">@font/font_inter</item>
        <item name="fontFamily">@font/font_inter</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textViewStyle">@style/Widget.KPSSArena.TextView</item>

        <!-- Material 3 Typography Overrides -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.KPSSArena.HeadlineLarge</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.KPSSArena.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.KPSSArena.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.KPSSArena.HeadlineMedium</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.KPSSArena.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.KPSSArena.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.KPSSArena.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.KPSSArena.Button</item>

        <!-- Component Styles -->
        <item name="materialButtonStyle">@style/Widget.KPSSArena.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.KPSSArena.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.KPSSArena.Card</item>

        <!-- Shape appearance -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.KPSSArena.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.KPSSArena.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.KPSSArena.Large</item>
    </style>

    <!-- Splash theme -->
    <style name="Theme.KPSSArena.Splash" parent="Theme.KPSSArena">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Shape Appearances -->
    <style name="ShapeAppearance.KPSSArena.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.KPSSArena.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.KPSSArena.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Tactile Primary Button -->
    <style name="Widget.KPSSArena.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="rippleColor">#33FFFFFF</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.KPSSArena.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.0</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#142563EB</item>
    </style>

    <!-- Crisp Elevated Editorial Card -->
    <style name="Widget.KPSSArena.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Base TextView Style -->
    <style name="Widget.KPSSArena.TextView" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/font_inter</item>
        <item name="fontFamily">@font/font_inter</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <!-- Crisp Editorial Typography -->
    <style name="TextAppearance.KPSSArena.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.KPSSArena.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.18</item>
    </style>
    <style name="TextAppearance.KPSSArena.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="TextAppearance.KPSSArena.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/inter_semibold</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>
    <style name="TextAppearance.KPSSArena.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>
    <style name="TextAppearance.KPSSArena.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textStyle">normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.KPSSArena.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/surface</item>
        <item name="itemTextColor">@color/bottom_nav_color_selector</item>
        <item name="itemIconTint">@color/bottom_nav_color_selector</item>
    </style>
    <style name="Widget.KPSSArena.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
        <item name="android:width">48dp</item>
        <item name="android:height">28dp</item>
    </style>
    <style name="BottomNavActiveText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">@font/inter_bold</item>
    </style>
    <style name="BottomNavInactiveText" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>
</resources>
